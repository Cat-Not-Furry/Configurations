# Archivos generados por compilación (C / pacman)
*.o
*.tar.gz
*.pkg.tar.zst
dwm
st

# Directorios de empaquetado (pacman)
pacman/
pkg/
src/
body/

# Backups y temporales
*~
*.swp
*.swo
*.bak
build.log

# Archivos del sistema
.DS_Store
Thumbs.db

# Python
**/__pycache__/
**/__pycache__/**
*.py[cod]
**/*.cpython-*.pyc
**/*.pyc
**/*.pyo
*$py.class

# Rust / Cargo (artefactos de build)
**/target/

# Waybar — generados en runtime (hyprland/waybar)
hyprland/waybar/waybar-autohide-state.css
waybar/waybar-autohide-state.css

# Repos aparte (cada uno con .git/ y .gitignore propio; no indexar en configurations)
i3space/
waybar-auto-hide-cnf/

# CopyQ — estado local de la sesión (no versionar)
copyq/copyq.lock
copyq/copyq.pub
copyq/copyq_geometry.ini
copyq/copyq_tabs.ini

# fondos/other — JPG extraídos localmente (los .7z sí van en el repo)
fondos/other/*.jpg
fondos/other/*.jpeg
fondos/other/*.png
fondos/other/*.webp
fondos/other/other-*.7z.xml

# cnf-bin — secretos, local y artefactos (shared/cnf-bin + legacy cnf-bin/)
shared/cnf-bin/config.local.toml
cnf-bin/config.local.toml
shared/cnf-bin/secrets/*.env
cnf-bin/secrets/*.env
!shared/cnf-bin/secrets/*.example
!cnf-bin/secrets/*.example
shared/cnf-bin/cnf-info/target/
shared/cnf-bin/cnf-media/target/
cnf-bin/cnf-info/target/
shared/cnf-bin/apps/**/logs/
cnf-bin/apps/**/logs/
shared/cnf-bin/backups/
cnf-bin/backups/
# Binarios compilados (install manual → /usr/local/bin)
shared/cnf-bin/bin/cnf-info
shared/cnf-bin/bin/cnf-media
cnf-bin/bin/cnf-info